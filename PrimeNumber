import java.util.*;

public class PrimeNum {
    public static void main(String[] args) {
        int n = 17;
        isPrime(n);
    }

    public static void isPrime(int n) {

        int count = 0;
        int i = 1;

        while (i <= n) {
            if (n % i == 0) {
                count++;
            }
            i++;
        }

        if (count == 2) {
            System.out.println("Number is prime!");
        } else {
            System.out.println("Number is not prime!");
        }
    }
}
